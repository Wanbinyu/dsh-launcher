<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DshLauncher</RootNamespace>
    <AssemblyName>dsh-launcher</AssemblyName>
    <Version>0.3.5</Version>
    <AssemblyVersion>0.3.5.0</AssemblyVersion>
    <FileVersion>0.3.5.0</FileVersion>
    <InformationalVersion>0.3.5</InformationalVersion>
    <ApplicationIcon>..\..\assets\dsh-launcher.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DshLauncher.Tests" />
    <EmbeddedResource Include="..\..\assets\dsh-launcher.ico">
      <LogicalName>DshLauncher.Assets.dsh-launcher.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
